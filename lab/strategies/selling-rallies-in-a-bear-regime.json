{
  "kalibre": 3,
  "name": "Selling Rallies in a Bear Regime",
  "description": "Sell short-term overbought moves in a falling market.",
  "timeframe": "D1",
  "direction": "short_only",
  "indicators": {
    "sma200": {
      "type": "SMA",
      "period": 200
    },
    "sma5": {
      "type": "SMA",
      "period": 5
    },
    "rsi2": {
      "type": "RSI",
      "period": 2
    },
    "atr": {
      "type": "ATR",
      "period": 14
    }
  },
  "entry": {
    "short": {
      "all": [
        {
          "left": "price.close",
          "op": "<",
          "right": "sma200"
        },
        {
          "left": "rsi2",
          "op": ">",
          "right": 90
        }
      ]
    }
  },
  "exit": {
    "stop": {
      "type": "atr",
      "indicator": "atr",
      "multiplier": 2.5
    },
    "max_bars": 10,
    "condition": {
      "short": {
        "all": [
          {
            "left": "price.close",
            "op": "<",
            "right": "sma5"
          }
        ]
      }
    }
  },
  "risk": {
    "risk_per_trade_pct": 0.75,
    "max_open_positions": 1
  }
}

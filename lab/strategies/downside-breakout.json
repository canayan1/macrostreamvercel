{
  "kalibre": 3,
  "name": "Downside Breakout",
  "description": "SMA50 break in a strong downtrend.",
  "timeframe": "H4",
  "direction": "short_only",
  "indicators": {
    "sma50": {
      "type": "SMA",
      "period": 50
    },
    "sma200": {
      "type": "SMA",
      "period": 200
    },
    "adx": {
      "type": "ADX",
      "period": 14
    },
    "atr": {
      "type": "ATR",
      "period": 14
    }
  },
  "entry": {
    "short": {
      "all": [
        {
          "left": "price.close",
          "op": "crosses_below",
          "right": "sma50"
        },
        {
          "left": "price.close",
          "op": "<",
          "right": "sma200"
        },
        {
          "left": "adx",
          "op": ">",
          "right": 25
        },
        {
          "left": "adx.minus",
          "op": ">",
          "right": "adx.plus"
        }
      ]
    }
  },
  "exit": {
    "stop": {
      "type": "atr",
      "indicator": "atr",
      "multiplier": 2
    },
    "target": {
      "type": "r",
      "value": 2
    },
    "trailing_stop": {
      "type": "atr",
      "indicator": "atr",
      "multiplier": 3
    }
  },
  "risk": {
    "risk_per_trade_pct": 0.75,
    "max_open_positions": 1,
    "daily_max_loss_pct": 2
  }
}
